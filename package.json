{
  "name": "juragan-warteg",
  "private": true,
  "version": "1.4.0",
  "description": "Kairosoft-style pixel-art warteg tycoon: grow a food cart into a national franchise. Phaser 4 + TypeScript + Vite, installable PWA.",
  "author": "KodeKecil",
  "license": "MIT",
  "homepage": "https://juraganwarteg.kodekecil.my.id",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vhmns14/juragan-warteg.git"
  },
  "bugs": {
    "url": "https://github.com/vhmns14/juragan-warteg/issues"
  },
  "keywords": [
    "game",
    "phaser",
    "typescript",
    "vite",
    "pixel-art",
    "indonesia",
    "simulation",
    "pwa"
  ],
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build && node tools/csp-headers.mjs dist",
    "build:single": "tsc --noEmit && vite build --config vite.single.config.ts",
    "preview": "vite preview",
    "build:all": "npm run build && npm run build:single",
    "test:e2e": "node tools/e2e.mjs dist shots",
    "test:resp": "node tools/shot-resp.mjs dist shots/resp",
    "test:soak": "node tools/soak.mjs 10 smart",
    "balance": "rolldown tools/balance.ts --file .balance.mjs --platform node && node .balance.mjs smart 10 1",
    "assets": "python3 tools/assets.py",
    "embed": "python3 tools/build-embed.py",
    "test:walk": "node tools/walk-check.mjs dist",
    "test:outside": "node tools/shot-outside.mjs dist shots/outside 1920x1080,1366x600,1280x720,390x844,360x740"
  },
  "dependencies": {
    "@fontsource/baloo-2": "^5.3.0",
    "@fontsource/pixelify-sans": "^5.3.0",
    "@fontsource/silkscreen": "^5.3.0",
    "phaser": "4.2.1"
  },
  "devDependencies": {
    "playwright": "1.56",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "vite-plugin-singlefile": "^2.3.3"
  }
}
